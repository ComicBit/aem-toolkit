{
  "manifest_version": 3,
  "name": "AEM Toolkit (Firefox)",
  "version": "1.2",
  "description": "Firefox build of AEM Toolkit.",
  "browser_specific_settings": {
    "gecko": {
      "id": "aem-toolkit@example.com",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "menus"
  ],
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}
